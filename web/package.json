{
  "name": "leafwake-web",
  "version": "1.0.0-rc.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/copy-libarchive.mjs",
    "dev": "node server.mjs",
    "prebuild": "node scripts/copy-libarchive.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "qa:server": "node qa/server.mjs",
    "qa:oidc": "node qa/oidc.mjs",
    "qa:deploy": "node qa/deploy.mjs",
    "i18n:validate": "node scripts/validate-web-translations.mjs",
    "test:installation": "node --test qa/fullstack-installation.mjs"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-select": "2.3.7",
    "@tanstack/react-query": "5.104.0",
    "bcryptjs": "3.0.3",
    "epubjs": "0.3.88",
    "fast-xml-parser": "5.11.2",
    "foliate-js": "1.0.1",
    "hls.js": "1.7.3",
    "libarchive.js": "2.0.2",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "nodemailer": "10.0.14",
    "openid-client": "6.8.8",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "yazl": "3.3.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yazl": "3.3.1",
    "fake-indexeddb": "6.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
